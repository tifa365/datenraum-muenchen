{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue", "pv-sdk/**/*", "src/global.d.ts", "config/**/*"],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "module": "Node16",
    "composite": false,
    "allowJs": true,
    "moduleResolution": "node16",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
    },
    "types": ["unplugin-icons/types/vue"],
    "noEmit": true

  }
}
