    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/",
    "change-project": "./change-project.sh",
    "setup-submodules": "cd pv-sdk && pnpm build",
    "setup-pv-sdk-core": "cd pv-sdk/packages/sdk-core && pnpm install",
    "setup-pv-sdk-vue": "cd pv-sdk/packages/sdk-vue && pnpm install",
